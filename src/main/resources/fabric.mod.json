{
  "schemaVersion": 1,
  "id": "jinfo",
  "version": "${version}",
  "name": "JInfo",
  "description": "Player profiles stored in a Cloudflare Worker + D1. Works with both online and offline accounts.",
  "authors": ["mcchopik"],
  "contact": {
    "homepage": "https://github.com/mcchopik/jinfo",
    "sources": "https://github.com/mcchopik/jinfo",
    "issues": "https://github.com/mcchopik/jinfo/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mcchopik.jinfo.JInfoClient"
    ],
    "modmenu": [
      "com.mcchopik.jinfo.compat.JInfoModMenu"
    ],
    "main": [
      "com.mcchopik.jinfo.JInfoMod"
    ]
  },
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}