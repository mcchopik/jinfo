{
  "schemaVersion": 1,
  "id": "jinfo-server",
  "version": "${version}",
  "name": "JInfo Server",
  "description": "Server-side component for JInfo player profiles. Provides HTTP API and web UI for viewing profiles without client mod.",
  "authors": ["mcchopik"],
  "contact": {
    "homepage": "https://github.com/mcchopik/jinfo",
    "sources": "https://github.com/mcchopik/jinfo/tree/server",
    "issues": "https://github.com/mcchopik/jinfo/issues"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "com.mcchopik.jinfo.server.JInfoServerMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}